APP_NAME=Context Trust Layer
APP_ENV=development

POSTGRES_DB=context_trust
POSTGRES_USER=context_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
# Note: Use 5433 if running via provided docker-compose.yml (maps 5433:5432), or 5432 if running native postgres
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://context_user:change_me@localhost:5433/context_trust

# ==============================================================================
# LLM & Reasoning Engine Configuration
# ==============================================================================
# Supported options: "mock", "openrouter", "openai", "ollama"
LLM_PROVIDER=mock

# ------------------------------------------------------------------------------
# Option A: OpenRouter / Ox Alpha (Z.ai GLM-5.3-Flash)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# Option B: OpenAI Direct
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# Option C: Local Ollama
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=120

# ------------------------------------------------------------------------------
# Slack Policy Assistant (Read-Only Pilot)
# ------------------------------------------------------------------------------
SLACK_ENABLED=true
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_APP_ID=
SLACK_REDIRECT_URI=https://<your-ngrok-or-domain>/v1/slack/oauth/callback
SLACK_WORKER_CONCURRENCY=4
SLACK_JOB_POLL_INTERVAL_MS=500
TRULIN_PUBLIC_URL=https://app.trulin.ai

