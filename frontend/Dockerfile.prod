# =========================================================================
# STAGE 1: Build production static distribution using Node.js
# =========================================================================
FROM node:18-alpine AS builder

WORKDIR /app

# Install dependencies using package-lock for reproducible builds
COPY package*.json ./
RUN npm ci

# Copy application source
COPY . .

# Build argument for backend API base URL (empty defaults to same-origin /api reverse-proxy)
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Compile and minify Vite production distribution
RUN npm run build

# =========================================================================
# STAGE 2: Lightweight Production Runtime with NGINX Alpine
# =========================================================================
FROM nginx:1.25-alpine

# Remove default nginx website configuration
RUN rm -rf /etc/nginx/conf.d/*

# Copy custom enterprise NGINX configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose HTTP port
EXPOSE 80

# Container healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/healthz || exit 1

# Launch Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
