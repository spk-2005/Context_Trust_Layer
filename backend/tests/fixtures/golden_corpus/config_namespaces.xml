<?xml version="1.0" encoding="UTF-8"?>
<sec:securityConfig xmlns:sec="http://trulin.io/security" xmlns:gov="http://trulin.io/governance">
  <gov:policy id="POL-901" version="2.0">
    <gov:rule id="RULE-01" level="mandatory">
      <sec:enforceTLS version="1.3">All endpoints must enforce TLS 1.3 encryption.</sec:enforceTLS>
    </gov:rule>
    <gov:rule id="RULE-02" level="recommended">
      <sec:rotateKeys frequency="90days">API keys should rotate every 90 days.</sec:rotateKeys>
    </gov:rule>
  </gov:policy>
</sec:securityConfig>
