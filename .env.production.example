# ==============================================================================
# Context Trust Layer (CTL) — Production Environment Template
# ==============================================================================
# IMPORTANT: Copy this file to .env.production on your production server.
# NEVER commit your populated .env.production file to version control.

APP_NAME=Context Trust Layer
APP_ENV=production

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16 with pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=context_trust
POSTGRES_USER=context_user
# Generate a secure 32+ character random password in production
POSTGRES_PASSWORD=your_strong_random_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async connection string for SQLAlchemy / asyncpg
DATABASE_URL=postgresql+asyncpg://context_user:your_strong_random_password_here@postgres:5432/context_trust

# ------------------------------------------------------------------------------
# 2. Concurrency & Performance
# ------------------------------------------------------------------------------
# Recommended: 2 to 4 workers per CPU core
WEB_CONCURRENCY=4
FRONTEND_PORT=4000
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# 3. Cryptographic Keys & Secrets (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=your_64_character_hex_secret_key_here
JWT_SECRET=your_64_character_hex_jwt_secret_here

# ------------------------------------------------------------------------------
# 4. Security & CORS Whitelist
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (your production domains)
CORS_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com

# ------------------------------------------------------------------------------
# 5. Enterprise Google OAuth SSO (Optional / As Needed)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ------------------------------------------------------------------------------
# 6. LLM Provider (mock, openai, openrouter, or ollama)
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
